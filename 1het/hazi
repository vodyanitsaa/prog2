#include <stdio.h>
#include <math.h>
#define size 10

//gcc hazi.c -lm

int find(int tomb[], int ertek){
    for(int i = 0; i < size; ++i){
        if(tomb[i] == ertek){
            return i+1;
        }
    }
    return -1;
}

void tomb_kiir(int tomb[]){
    for(int i = 0; i < size; ++i){
        fprintf(stdout, "%d ", tomb[i]);
    }
    puts("");
}

struct Pont{
    int x;
    int y;
};

double distance(struct Pont p1, struct Pont p2) {
    int dx = p1.x - p2.x;
    int dy = p1.y - p2.y;
    return sqrt(dx * dx + dy * dy);
}

int main(){
    int tomb[size] = {2,6,3,4,12,8,0,1,7,10};

    fprintf(stdout, "Az érték helye: %d\n", find(tomb, 7));

    tomb_kiir(tomb);

    struct Pont A;
    A.x = 1;
    A.y = 2;
    struct Pont B;
    B.x = 6;
    B.y = 5;
    
    fprintf(stdout,"A két pont közti távolság: %lf\n", distance(A, B));

    return 0;
}
