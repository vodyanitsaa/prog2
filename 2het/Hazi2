import java.util.Scanner;

class Negyzet
{
    int a;
    public Negyzet(int a)
    {
        this.a = a;
    }
    public int kerulet()
    {
        return 4 * a;
    }
    public int terulet()
    {
        return a * a;
    }
}

class Teglalap
{
    int c;
    int d;
    public Teglalap(int c, int d)
    {
        this.c = c;
        this.d = d;
    }
    public int kerulet()
    {
        return 2 * (c + d);
    }
    public int terulet()
    {
        return c * d;
    }
}

class Circle
{
    double r;
    public Circle(double r)
    {
        this.r = r;
    }
    public double kerulet()
    {
        return 2 * r * Math.PI;
    }
    public double terulet()
    {
        return r * r * Math.PI;
    }
}

class Gomb
{
    double gr;
    public Gomb(double gr)
    {
        this.gr = gr;
    }
    public double felszin()
    {
        return 4 * (gr * gr) * Math.PI;
    }
    public double terfogat()
    {
        return 4/3 * (gr*gr*gr) * Math.PI;
    }

}

public class Hazi2
{
    public static void main(String[] args)
    {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Kérem a négyzet oldalának hosszát (egész szám): ");
        int oldal = scanner.nextInt();

        Negyzet negyzet = new Negyzet(oldal);

        int k = negyzet.kerulet();
        int t = negyzet.terulet();

        System.out.printf("A négyzet kerülete: %d\n", k);
        System.out.printf("A négyzet területe: %d\n", t);

        scanner.nextLine();

        System.out.println("Kérem a téglalap oldalainak hosszát (egész számok): ");
        int o1 = scanner.nextInt();
        int o2 = scanner.nextInt();

        Teglalap teglalap = new Teglalap(o1, o2);

        int tk = teglalap.kerulet();
        int tt = teglalap.terulet();

        System.out.printf("A négyzet kerülete: %d\n", tk);
        System.out.printf("A négyzet területe: %d\n", tt);

        scanner.nextLine();

        System.out.println("Kérem a kör sugarát: ");
        int r = scanner.nextInt();

        Circle circle = new Circle(r);

        double ker = circle.kerulet();
        double ter = circle.terulet();

        System.out.printf("A kör kerülete: %.2f\n", ker);
        System.out.printf("A kör területe: %.2f\n", ter);

        scanner.nextLine();

        System.out.println("Kérem a gömb sugarát: ");
        int gr = scanner.nextInt();

        Gomb gomb = new Gomb(gr);

        double gfel = gomb.felszin();
        double gter = gomb.terfogat();

        System.out.printf("A gömb felszíne: %.2f\n", gfel);
        System.out.printf("A kör térfogata: %.2f\n", gter);
    }
}
