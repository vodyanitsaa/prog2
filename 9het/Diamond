public class Main {
    public static void main(String[] args) {
        System.out.println("Magasság: 3");
        diamond(3);
        System.out.println();
        System.out.println("Magasság: 7");
        diamond(7);
        System.out.println();
        System.out.println("Magasság: 4");
        diamond(4);
    }

    public static void diamond(int m) {

        //assert m % 2 != 0;

        if (m % 2 == 0 || m <= 0) {
            System.out.println("Hiba, csak pozitív páratlan magasságot adhatunk meg!");
            return;
        }
        for (int i = 1; i <= m; i += 2) {
            for (int j = 0; j < (m - i) / 2; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
        for (int i = m - 2; i >= 1; i -= 2) {
            for (int j = 0; j < (m - i) / 2; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
