import java.util.Random;

public class Main {
    public static void main(String[] args){
        for (int i = 0; i < 10; ++i){
            System.out.println(randRange(10,15));
        }
    }

    public static int randRange(int a, int b){
        Random rand = new Random();
        return rand.nextInt(a, b);
    }
}

